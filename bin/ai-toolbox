#!/usr/bin/env bash
# ai-toolbox — set up ai-toolbox pieces in a repo with one command.
#
# The deterministic hands of the toolkit: copy hooks, merge Claude Code settings.json /
# .mcp.json AND Codex .codex/config.toml, copy skills, print rule snippets — idempotently,
# from any repo. `/init` (the skill) is the model-driven brain that decides WHAT to install
# and calls these subcommands; `ai-toolbox bootstrap` is the shell-only equivalent.
#
# One source, two harnesses: the same hook scripts, skill folders, and MCP presets are
# converted at install time to each harness's on-disk format (never authored twice).
# It reads the ai-toolbox's own directories at runtime, so nothing here duplicates their
# contents and `ai-toolbox list` never drifts. JSON merges use python3; Codex TOML is
# emitted by bin/lib/*.py (stdlib tomllib reads TOML but can't write it). Every write is
# idempotent. See --harness in `ai-toolbox help`.
#
# Usage: ai-toolbox <command> [args]   —   run `ai-toolbox help` for the full list.
set -euo pipefail

# --- locate the ai-toolbox (resolving symlinks, so a PATH symlink still works) ---
_self="${BASH_SOURCE[0]}"
while [ -h "$_self" ]; do
  _dir=$(cd -P "$(dirname "$_self")" && pwd)
  _self=$(readlink "$_self")
  case "$_self" in /*) ;; *) _self="$_dir/$_self" ;; esac
done
TOOLBOX_ROOT="${AI_TOOLBOX:-$(cd -P "$(dirname "$_self")/.." && pwd)}"

# --- output helpers (color only on a tty, honoring NO_COLOR) ---
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  _dim=$'\033[2m'; _grn=$'\033[32m'; _ylw=$'\033[33m'; _red=$'\033[31m'; _bld=$'\033[1m'; _rst=$'\033[0m'
else
  _dim=; _grn=; _ylw=; _red=; _bld=; _rst=
fi
ok()   { printf '%s✓%s %s\n'  "$_grn" "$_rst" "$*"; }
info() { printf '%s%s%s\n'    "$_dim" "$*" "$_rst" >&2; }
warn() { printf '%s! %s%s\n'  "$_ylw" "$*" "$_rst" >&2; }
die()  { printf '%sai-toolbox: %s%s\n' "$_red" "$*" "$_rst" >&2; exit 1; }
head_() { printf '\n%s%s%s\n' "$_bld" "$*" "$_rst"; }
have() { command -v "$1" >/dev/null 2>&1; }
need_py() { have python3 || die "python3 is required for JSON merging (jq alone can't do the dedup-union merge). Install python3."; }

# --- global option pre-pass: pull out --repo / --harness from anywhere ---
REPO=""; HARNESS=""
_argv=()
while [ $# -gt 0 ]; do
  case "$1" in
    --repo) REPO="${2:?--repo needs a path}"; shift 2 ;;
    --repo=*) REPO="${1#*=}"; shift ;;
    --harness) HARNESS="${2:?--harness needs claude|codex|both}"; shift 2 ;;
    --harness=*) HARNESS="${1#*=}"; shift ;;
    *) _argv+=("$1"); shift ;;
  esac
done
set -- ${_argv[@]+"${_argv[@]}"}
: "${REPO:=$PWD}"
[ -d "$REPO" ] || die "target repo not found: $REPO"

# python helpers that emit/merge Codex config.toml (tomllib can read but not write TOML)
CODEX_LIB="$TOOLBOX_ROOT/bin/lib"

# --- harness selection: which coding-agent homes to write for ---
# --harness claude|codex|both overrides; otherwise auto-detect the homes that exist.
# When neither is present we default to Claude (backward-compatible).
declare -a HARNESSES=()
resolve_harnesses() {
  case "$HARNESS" in
    claude) HARNESSES=(claude) ;;
    codex)  HARNESSES=(codex) ;;
    pi)     HARNESSES=(pi) ;;
    both)   HARNESSES=(claude codex) ;;
    all)    HARNESSES=(claude codex pi) ;;
    "")
      local has_codex=0 has_claude=0 has_pi=0
      { [ -d "$HOME/.codex" ] || [ -d "$REPO/.codex" ]; } && has_codex=1
      { [ -d "$HOME/.claude" ] || [ -d "$REPO/.claude" ] || [ -f "$REPO/.mcp.json" ]; } && has_claude=1
      { [ -d "$HOME/.pi" ] || [ -d "$REPO/.pi" ]; } && has_pi=1
      HARNESSES=()
      [ "$has_claude" -eq 1 ] && HARNESSES+=(claude)
      [ "$has_codex" -eq 1 ] && HARNESSES+=(codex)
      [ "$has_pi" -eq 1 ] && HARNESSES+=(pi)
      # When no harness has been initialized, preserve the original Claude-first default.
      [ "${#HARNESSES[@]}" -gt 0 ] || HARNESSES=(claude)
      ;;
    *) die "unknown --harness: $HARNESS (use claude|codex|pi|both|all)" ;;
  esac
}

# ----------------------------------------------------------------------------
# hooks — copy hook scripts + merge their wiring into .claude/settings.json
# ----------------------------------------------------------------------------
cmd_hooks() {
  need_py
  local all=() names=()
  for f in "$TOOLBOX_ROOT"/hooks/*.sh; do
    b=$(basename "$f" .sh); [ "$b" = "_lib" ] && continue; all+=("$b")
  done
  if [ $# -eq 0 ]; then names=("${all[@]}"); else
    for n in "$@"; do names+=("${n%.sh}"); done
  fi
  for n in "${names[@]}"; do
    [ -f "$TOOLBOX_ROOT/hooks/$n.sh" ] || die "no such hook: $n (see 'ai-toolbox list')"
  done
  resolve_harnesses
  for h in "${HARNESSES[@]}"; do
    case "$h" in
      claude) _hooks_claude "${names[@]}" ;;
      codex)  _hooks_codex  "${names[@]}" ;;
      pi)     info "pi: shell hooks aren't wired for pi yet (pi uses TypeScript extensions) - skipped." ;;
    esac
  done
}

# copy the shared hook scripts into <dir> and echo the CSV of installed <name>.sh
_hooks_copy() {
  local dir="$1"; shift
  mkdir -p "$dir"
  cp "$TOOLBOX_ROOT/hooks/_lib.sh" "$dir/" && chmod +x "$dir/_lib.sh"
  local installed=""
  for n in "$@"; do
    cp "$TOOLBOX_ROOT/hooks/$n.sh" "$dir/" && chmod +x "$dir/$n.sh"
    installed="${installed:+$installed,}$n.sh"
  done
  printf '%s' "$installed"
}

# Claude Code: scripts in .claude/hooks + wiring merged into .claude/settings.json
_hooks_claude() {
  local installed; installed=$(_hooks_copy "$REPO/.claude/hooks" "$@")
  for n in "$@"; do ok "hook  .claude/hooks/$n.sh"; done
  python3 - "$TOOLBOX_ROOT/hooks/settings.hooks.json" "$REPO/.claude/settings.json" "$installed" <<'PY'
import json, os, sys
src = json.load(open(sys.argv[1]))
tgt_path = sys.argv[2]
installed = set(x for x in sys.argv[3].split(",") if x)
tgt = {}
if os.path.exists(tgt_path):
    with open(tgt_path) as f: tgt = json.load(f)
tgt_hooks = tgt.setdefault("hooks", {})
for event, matchers in src.get("hooks", {}).items():
    tgt_list = tgt_hooks.setdefault(event, [])
    for m in matchers:
        inner = [h for h in m.get("hooks", [])
                 if os.path.basename(h.get("command", "").strip()) in installed]
        if not inner: continue
        key = m.get("matcher")
        existing = next((x for x in tgt_list if x.get("matcher") == key), None)
        if existing is None:
            existing = {k: v for k, v in m.items() if k != "hooks"}
            existing["hooks"] = []
            tgt_list.append(existing)
        seen = {h.get("command") for h in existing["hooks"]}
        for h in inner:
            if h.get("command") not in seen:
                existing["hooks"].append(h); seen.add(h.get("command"))
with open(tgt_path, "w") as f:
    json.dump(tgt, f, indent=2); f.write("\n")
PY
  ok "wired  .claude/settings.json"
  info "Run /hooks in Claude Code to confirm they're registered."
}

# Codex: same scripts in .codex/hooks + [hooks] tables merged into .codex/config.toml.
# Command paths are cwd-relative (Codex runs hooks from the session root — no
# ${CLAUDE_PROJECT_DIR} needed). Bash-matched hooks fire today; Write/Edit (apply_patch)
# firing is still maturing upstream (codex#16732).
_hooks_codex() {
  local installed; installed=$(_hooks_copy "$REPO/.codex/hooks" "$@")
  for n in "$@"; do ok "hook  .codex/hooks/$n.sh"; done
  python3 - "$TOOLBOX_ROOT/hooks/settings.hooks.json" "$REPO/.codex/config.toml" "$installed" "$CODEX_LIB" <<'PY'
import json, os, sys
sys.path.insert(0, sys.argv[4])
import codex_toml as ct
src = json.load(open(sys.argv[1]))
cfg_path = sys.argv[2]
installed = set(x for x in sys.argv[3].split(",") if x)
patch = {}
for event, matchers in src.get("hooks", {}).items():
    outm = []
    for m in matchers:
        inner = []
        for hk in m.get("hooks", []):
            base = os.path.basename(hk.get("command", "").strip())
            if base in installed:
                nh = dict(hk); nh["command"] = ".codex/hooks/%s" % base
                inner.append(nh)
        if inner:
            g = {k: v for k, v in m.items() if k != "hooks"}; g["hooks"] = inner
            outm.append(g)
    if outm: patch[event] = outm
cfg = ct.load(cfg_path)
ct.merge_hooks(cfg, patch)
os.makedirs(os.path.dirname(cfg_path), exist_ok=True)
with open(cfg_path, "w") as f: f.write(ct.dumps(cfg))
PY
  ok "wired  .codex/config.toml [hooks]"
  info "Codex trusts a hook only after you review it — run 'codex' and approve, or check /hooks."
}

# ----------------------------------------------------------------------------
# mcp — merge preset(s) into .mcp.json (+ auto-drop any helper scripts they use)
# ----------------------------------------------------------------------------
cmd_mcp() {
  need_py
  [ $# -gt 0 ] || die "usage: ai-toolbox mcp <preset...>   (see 'ai-toolbox list')"
  local presets=()
  for n in "$@"; do
    local p="$TOOLBOX_ROOT/mcp/presets/${n%.json}.json"
    [ -f "$p" ] || die "no such preset: $n (see 'ai-toolbox list')"
    presets+=("$p")
  done
  resolve_harnesses
  for h in "${HARNESSES[@]}"; do
    case "$h" in
      claude) _mcp_claude "${presets[@]}" ;;
      codex)  _mcp_codex  "${presets[@]}" ;;
      pi)     _mcp_pi     "${presets[@]}" ;;
    esac
  done
  _mcp_report_secrets "${presets[@]}"
}

# copy the repo mcp helper scripts (with-dotenv.sh, dotenv-header.sh, …) named in <files>
# into <dir>, matching them by the given path prefix (.claude/mcp/ or .codex/mcp/).
_mcp_copy_helpers() {
  local dir="$1" prefix="$2"; shift 2
  local helpers h
  helpers=$(grep -hoE "${prefix//./\\.}[A-Za-z0-9_-]+\.sh" "$@" 2>/dev/null | sed 's#.*/##' | sort -u || true)
  [ -n "$helpers" ] || return 0
  mkdir -p "$dir"
  for h in $helpers; do
    [ -f "$TOOLBOX_ROOT/mcp/$h" ] || continue
    cp "$TOOLBOX_ROOT/mcp/$h" "$dir/" && chmod +x "$dir/$h"
    ok "mcp   $h  ->  ${dir#$REPO/}/"
  done
}

# Claude Code: merge preset mcpServers into .mcp.json (native Claude format)
_mcp_claude() {
  local tgt="$REPO/.mcp.json"
  python3 - "$tgt" "$@" <<'PY'
import json, os, sys
tgt_path = sys.argv[1]
tgt = {"mcpServers": {}}
if os.path.exists(tgt_path):
    tgt = json.load(open(tgt_path)); tgt.setdefault("mcpServers", {})
for p in sys.argv[2:]:
    for name, cfg in json.load(open(p)).get("mcpServers", {}).items():
        tgt["mcpServers"][name] = cfg
with open(tgt_path, "w") as f:
    json.dump(tgt, f, indent=2); f.write("\n")
PY
  for p in "$@"; do ok "mcp   $(basename "${p%.json}")  ->  .mcp.json"; done
  _mcp_copy_helpers "$REPO/.claude/mcp" ".claude/mcp/" "$@"
}

# Codex: convert presets to [mcp_servers.*] tables merged into .codex/config.toml,
# then copy any helper scripts the converted config references.
_mcp_codex() {
  local tgt="$REPO/.codex/config.toml"
  mkdir -p "$REPO/.codex"
  local w; w=$(python3 "$CODEX_LIB/mcp_codex.py" "$tgt" "$@")
  for p in "$@"; do ok "mcp   $(basename "${p%.json}")  ->  .codex/config.toml"; done
  _mcp_copy_helpers "$REPO/.codex/mcp" ".codex/mcp/" "$tgt"
  if [ -n "$w" ]; then printf '%s\n' "$w" | while IFS= read -r line; do warn "$line"; done; fi
}

# Pi: convert presets to the pi-mcp-extension shape (bin/lib/mcp_pi.py) merged into
# .pi/mcp.json, then copy any helper scripts the converted config references. Pi's MCP
# client is the pi-mcp-extension package; secrets flow through .pi/mcp/with-dotenv.sh
# (pi does not interpolate config), and remote servers use OAuth via auth:{type:oauth}.
_mcp_pi() {
  local tgt="$REPO/.pi/mcp.json"
  mkdir -p "$REPO/.pi"
  local w; w=$(python3 "$CODEX_LIB/mcp_pi.py" "$tgt" "$@")
  for p in "$@"; do ok "mcp   $(basename "${p%.json}")  ->  .pi/mcp.json"; done
  _mcp_copy_helpers "$REPO/.pi/mcp" ".pi/mcp/" "$tgt"
  if [ -n "$w" ]; then printf '%s\n' "$w" | while IFS= read -r line; do warn "$line"; done; fi
}

# Pi MCP is an optional package, not part of Pi core. Both the initializer and the
# per-repo MCP follow-up use this strict check: it must be configured AND installed.
_pi_mcp_extension_ready() {
  [ -d "$HOME/.pi/agent/npm/node_modules/pi-mcp-extension" ] \
    && grep -q 'pi-mcp-extension' "$HOME/.pi/agent/settings.json" 2>/dev/null
}

# pi-init - one-time, global Pi MCP setup. Per-repo servers still belong in .pi/mcp.json
# and are added with `ai-toolbox mcp <preset> --harness pi`.
cmd_pi_init() {
  have pi || die "pi is not on PATH. Install it first: npm install -g --ignore-scripts @earendil-works/pi-coding-agent"
  if _pi_mcp_extension_ready; then
    ok "Pi MCP extension already installed globally (nothing to do)"
  else
    info "Installing pi-mcp-extension globally (reviewed package: npm:pi-mcp-extension)..."
    pi install npm:pi-mcp-extension
    _pi_mcp_extension_ready || die "pi install completed but pi-mcp-extension was not registered. Run 'pi install npm:pi-mcp-extension' and inspect ~/.pi/agent/settings.json."
    ok "Pi MCP extension installed globally"
  fi
  info "Next: in a repo, run 'ai-toolbox mcp <preset...> --harness pi'; restart pi, then /mcp."
}

# harness-aware follow-ups: which secrets to set, and how to connect
_mcp_report_secrets() {
  # ${VAR} placeholders resolve from the process env (skip always-set shell basics)
  local vars; vars=$(grep -hoE '\$\{[A-Z_][A-Z0-9_]*\}' "$@" 2>/dev/null \
    | grep -vE '^\$\{(HOME|USER|LOGNAME|PATH|PWD|SHELL|TMPDIR|LANG|TERM)\}$' | sort -u || true)
  if [ -n "$vars" ]; then
    warn "Set these in your environment before use (never inline a token):"
    printf '    %s\n' $vars >&2
  fi
  # vars read from the repo .env at connect time (via --need / dotenv-header.sh / with-dotenv)
  local envvars
  envvars=$( { grep -hoE '"--need",[[:space:]]*"[A-Z_][A-Z0-9_]*"' "$@"
               grep -hoE 'dotenv-header\.sh[[:space:]]+[A-Z_][A-Z0-9_]*' "$@"; } 2>/dev/null \
             | grep -oE '[A-Z_][A-Z0-9_]*' | sort -u || true)
  if [ -n "$envvars" ]; then
    warn "Put these in the repo's .env (read at launch via with-dotenv — no export needed):"
    printf '    %s\n' $envvars >&2
  fi
  local h
  for h in "${HARNESSES[@]}"; do
    case "$h" in
      claude) info "Claude Code: restart in this repo, then /mcp to connect (and complete any OAuth)." ;;
      codex)  info "Codex: run 'codex mcp login <server>' for OAuth servers; restart codex to load .codex/config.toml." ;;
      pi)
        if _pi_mcp_extension_ready; then
          info "Pi: restart pi in this repo, then /mcp to connect (OAuth servers open a browser login on first connect; tokens are cached)."
        else
          warn "Pi: run 'ai-toolbox pi-init' once to enable MCP, then restart pi and /mcp to connect."
        fi
        ;;
    esac
  done
}

# ----------------------------------------------------------------------------
# skill — copy a skill (or a group like 'cli') into a skills dir
# ----------------------------------------------------------------------------
# SKILL.md is a cross-agent standard — the same folder works in both harnesses. Claude
# Code reads .claude/skills/ (or ~/.claude/skills/); Codex reads .agents/skills/ (or
# $HOME/.agents/skills/). We install the identical folder into each detected harness's dir.
cmd_skill() {
  local user=0 names=()
  for a in "$@"; do
    case "$a" in --user) user=1 ;; *) names+=("$a") ;; esac
  done
  [ ${#names[@]} -gt 0 ] || die "usage: ai-toolbox skill <name...> [--user]   (see 'ai-toolbox list')"
  for n in "${names[@]}"; do
    [ -d "$TOOLBOX_ROOT/skills/$n" ] || die "no such skill: $n (see 'ai-toolbox list')"
  done
  resolve_harnesses
  # Codex and pi share .agents/skills - dedupe so a combined target installs once.
  local h dest seen=""
  for h in "${HARNESSES[@]}"; do
    case "$h" in
      claude)   [ "$user" -eq 1 ] && dest="$HOME/.claude/skills" || dest="$REPO/.claude/skills" ;;
      codex|pi) [ "$user" -eq 1 ] && dest="$HOME/.agents/skills" || dest="$REPO/.agents/skills" ;;
    esac
    case ":$seen:" in *":$dest:"*) continue ;; esac
    seen="$seen:$dest"
    _skill_install "$dest" "${names[@]}"
  done
}

_skill_install() {
  local dest="$1"; shift
  mkdir -p "$dest"
  local n
  for n in "$@"; do
    local src="$TOOLBOX_ROOT/skills/$n"
    if [ -f "$src/SKILL.md" ]; then
      rm -rf "$dest/$(basename "$n")"; cp -R "$src" "$dest/$(basename "$n")"
      ok "skill $n  ->  ${dest/#$HOME/~}/$(basename "$n")"
    else
      # a group dir (e.g. cli) — install each child skill flat
      local child cb
      for child in "$src"/*/; do
        [ -f "$child/SKILL.md" ] || continue
        cb=$(basename "$child")
        rm -rf "$dest/$cb"; cp -R "${child%/}" "$dest/$cb"
        ok "skill $n/$cb  ->  ${dest/#$HOME/~}/$cb"
      done
    fi
  done
}

# ----------------------------------------------------------------------------
# rules — PRINT stack snippets to stdout (they get inlined into AGENTS.md)
# ----------------------------------------------------------------------------
cmd_rules() {
  [ $# -gt 0 ] || die "usage: ai-toolbox rules <stack...>   (see 'ai-toolbox list')"
  for n in "$@"; do
    local f="$TOOLBOX_ROOT/starters/rules/${n%.md}.md"
    [ -f "$f" ] || die "no such rule snippet: $n (see 'ai-toolbox list')"
    printf '\n# ===== %s (starters/rules/%s.md) =====\n\n' "$n" "${n%.md}"
    cat "$f"
  done
  info "Snippets are seeds — paste the parts that apply into AGENTS.md, delete the rest. Nothing was written."
}

# ----------------------------------------------------------------------------
# with-dotenv — drop the .env loader used by some MCP presets
# ----------------------------------------------------------------------------
cmd_with_dotenv() {
  resolve_harnesses
  local h d
  for h in "${HARNESSES[@]}"; do
    case "$h" in claude) d="$REPO/.claude/mcp" ;; codex) d="$REPO/.codex/mcp" ;; pi) d="$REPO/.pi/mcp" ;; esac
    mkdir -p "$d"
    cp "$TOOLBOX_ROOT/mcp/with-dotenv.sh" "$d/" && chmod +x "$d/with-dotenv.sh"
    ok "mcp   with-dotenv.sh  ->  ${d#$REPO/}/"
  done
}

# ----------------------------------------------------------------------------
# base-charter — append the one always-on artifact into ~/.claude/CLAUDE.md
# ----------------------------------------------------------------------------
# The one always-on artifact goes in each harness's GLOBAL config: Claude Code reads
# ~/.claude/CLAUDE.md, Codex reads ~/.codex/AGENTS.md. An explicit path arg overrides.
cmd_base_charter() {
  if [ $# -ge 1 ]; then _charter_append "$1"; return 0; fi
  resolve_harnesses
  local h
  for h in "${HARNESSES[@]}"; do
    case "$h" in
      claude) _charter_append "$HOME/.claude/CLAUDE.md" ;;
      codex)  _charter_append "$HOME/.codex/AGENTS.md" ;;
      pi)     info "pi: no global charter file - put shared rules in the project AGENTS.md (pi reads it)." ;;
    esac
  done
  info "This is the one always-on artifact — do this once per machine, not per repo."
}

_charter_append() {
  local tgt="$1"
  local marker="<!-- ai-toolbox:base-charter -->"
  mkdir -p "$(dirname "$tgt")"
  if [ -f "$tgt" ] && grep -qF "$marker" "$tgt"; then
    ok "base charter already present in ${tgt/#$HOME/~} (nothing to do)"; return 0
  fi
  { printf '\n%s\n' "$marker"; cat "$TOOLBOX_ROOT/starters/base-charter.md"; printf '%s\n' "$marker"; } >> "$tgt"
  ok "appended base charter -> ${tgt/#$HOME/~}"
}

# ----------------------------------------------------------------------------
# stack detection -> recommendation (shared by recommend + bootstrap)
# ----------------------------------------------------------------------------
REC_HOOKS=(); REC_MCP=(); REC_SKILLS=(); REC_RULES=(); DETECTED=()
_has() { [ -e "$REPO/$1" ]; }
_pkg_has() { [ -f "$REPO/package.json" ] && grep -q "\"$1\"" "$REPO/package.json"; }
compute_reco() {
  REC_HOOKS=(format-on-edit session-context guard-irreversible conventional-commit)
  REC_MCP=(context7)
  REC_SKILLS=(pre-pr capture lint handoff)
  REC_RULES=(); DETECTED=()
  local generated=0
  if [ -f "$REPO/package.json" ]; then
    DETECTED+=("node/ts"); REC_RULES+=(typescript)
    if _pkg_has react || _pkg_has next; then
      DETECTED+=("react"); REC_RULES+=(react); REC_MCP+=(chrome-devtools playwright)
    fi
    _pkg_has vue && { DETECTED+=("vue"); REC_RULES+=(vue); REC_MCP+=(chrome-devtools playwright); }
    if _has app.json || _has app.config.js || _has app.config.ts || _pkg_has expo; then
      DETECTED+=("expo"); REC_RULES+=(expo); REC_MCP+=(expo); REC_SKILLS+=(cli/eas)
    fi
  fi
  if _has supabase || _pkg_has "@supabase/supabase-js"; then
    DETECTED+=("supabase"); REC_MCP+=(supabase); REC_SKILLS+=(cli/supabase); REC_RULES+=(supabase)
  fi
  _has fly.toml && { DETECTED+=("fly"); REC_SKILLS+=(cli/fly); }
  _has .github && { DETECTED+=("github"); REC_SKILLS+=(cli/gh); }
  _has go.mod && { DETECTED+=("go"); REC_RULES+=(go); }
  { _has composer.json && grep -q laravel "$REPO/composer.json" 2>/dev/null; } && { DETECTED+=("laravel"); REC_RULES+=(laravel); }
  if _has ProjectSettings/ProjectVersion.txt; then
    DETECTED+=("unity"); REC_RULES+=(unity); generated=1
    info "Unity: the unity MCP self-configures (Window -> MCP for Unity -> Configure) — no preset."
  fi
  { _has codegen.yml || _has codegen.ts || _has buf.gen.yaml || _has openapi.yaml; } && generated=1
  [ "$generated" -eq 1 ] && REC_HOOKS+=(protect-generated)
  [ ${#DETECTED[@]} -gt 0 ] || DETECTED=("unknown — generic set")
}

_print_reco() {
  head_ "Detected: ${DETECTED[*]}"
  printf '  %-8s %s\n' "hooks"  "${REC_HOOKS[*]}"
  printf '  %-8s %s\n' "mcp"    "${REC_MCP[*]}"
  printf '  %-8s %s\n' "skills" "${REC_SKILLS[*]}"
  printf '  %-8s %s%s\n' "rules"  "${REC_RULES[*]:-(none)}" "  (inline into AGENTS.md)"
}

cmd_recommend() { compute_reco; _print_reco; info "Run 'ai-toolbox bootstrap' to install (with confirmation), or a per-group command."; }

# ----------------------------------------------------------------------------
# bootstrap — recommend, confirm each group, install (shell-only smart path)
# ----------------------------------------------------------------------------
cmd_bootstrap() {
  local yes=0 dry=0
  for a in "$@"; do case "$a" in --yes|-y) yes=1 ;; --dry-run) dry=1 ;; esac; done
  compute_reco; _print_reco
  [ "$dry" -eq 1 ] && { info "--dry-run: nothing installed."; return 0; }
  if [ "$yes" -eq 0 ] && [ ! -t 0 ]; then
    die "not a tty — pass --yes to install non-interactively (or run each group by hand)."
  fi
  _confirm() { # $1 = prompt
    [ "$yes" -eq 1 ] && return 0
    local reply; printf '%s [Y/n] ' "$1" >&2; read -r reply </dev/tty || reply=""
    case "$reply" in [nN]*) return 1 ;; *) return 0 ;; esac
  }
  _confirm "Install hooks (${REC_HOOKS[*]})?"   && cmd_hooks "${REC_HOOKS[@]}"
  _confirm "Add MCPs (${REC_MCP[*]})?"          && cmd_mcp "${REC_MCP[@]}"
  _confirm "Install skills (${REC_SKILLS[*]})?" && cmd_skill "${REC_SKILLS[@]}"
  if [ ${#REC_RULES[@]} -gt 0 ] && _confirm "Show rule snippets to inline (${REC_RULES[*]})?"; then
    cmd_rules "${REC_RULES[@]}"
  fi
  head_ "Next: export any MCP secrets shown above, restart Claude Code, run /mcp to auth."
}

# ----------------------------------------------------------------------------
# init — scaffold the knowledge-file skeletons, then bootstrap the functional layer
# ----------------------------------------------------------------------------
cmd_init() {
  local dry=0
  for a in "$@"; do [ "$a" = "--dry-run" ] && dry=1; done
  resolve_harnesses
  if [ "$dry" -eq 0 ]; then
    # AGENTS.md is the cross-harness source of truth — Codex reads it natively, Claude via the adapter.
    if [ -f "$REPO/AGENTS.md" ]; then info "AGENTS.md already exists — leaving it."
    else cp "$TOOLBOX_ROOT/templates/AGENTS.template.md" "$REPO/AGENTS.md"; ok "scaffolded AGENTS.md (skeleton — fill in stack/commands/rules)"; fi
    # CLAUDE.md is only the Claude Code adapter (@AGENTS.md) — skip it for a Codex-only target.
    if printf '%s\n' "${HARNESSES[@]}" | grep -qx claude; then
      if [ -f "$REPO/CLAUDE.md" ]; then info "CLAUDE.md already exists — leaving it."
      else cp "$TOOLBOX_ROOT/templates/CLAUDE.template.md" "$REPO/CLAUDE.md"; ok "scaffolded CLAUDE.md (@AGENTS.md adapter)"; fi
    fi
  fi
  cmd_bootstrap "$@"
  [ "$dry" -eq 0 ] && head_ "Fill in AGENTS.md by hand, or run the /toolbox-init skill to author it by interview (it detects the stack and asks for the non-obvious rules)."
  return 0
}

# ----------------------------------------------------------------------------
# list — what the ai-toolbox offers (reads its own dirs, so it never drifts)
# ----------------------------------------------------------------------------
cmd_list() {
  head_ "hooks"
  for f in "$TOOLBOX_ROOT"/hooks/*.sh; do b=$(basename "$f" .sh); [ "$b" = "_lib" ] || printf '  %s\n' "$b"; done
  head_ "mcp presets"
  for f in "$TOOLBOX_ROOT"/mcp/presets/*.json; do printf '  %s\n' "$(basename "$f" .json)"; done
  head_ "skills"
  for d in "$TOOLBOX_ROOT"/skills/*/; do
    b=$(basename "$d")
    if [ -f "$d/SKILL.md" ]; then printf '  %s\n' "$b"
    else for c in "$d"*/; do [ -f "$c/SKILL.md" ] && printf '  %s/%s\n' "$b" "$(basename "$c")"; done; fi
  done
  head_ "rules (inline into AGENTS.md)"
  for f in "$TOOLBOX_ROOT"/starters/rules/*.md; do b=$(basename "$f" .md); [ "$b" = "README" ] || printf '  %s\n' "$b"; done
}

# ----------------------------------------------------------------------------
# status — what's already installed in the target repo
# ----------------------------------------------------------------------------
_st_line() { printf '  %-8s' "$1:"; }
_st_none() { printf '%s(none)%s\n' "$_dim" "$_rst"; }
cmd_status() {
  head_ "Repo: $REPO"
  printf '%sClaude Code%s\n' "$_bld" "$_rst"
  if [ -d "$REPO/.claude/hooks" ]; then _st_line hooks; ( cd "$REPO/.claude/hooks" && ls *.sh 2>/dev/null | grep -v '^_lib' | tr '\n' ' '; echo )
  else _st_line hooks; _st_none; fi
  if [ -f "$REPO/.mcp.json" ] && have python3; then _st_line mcp; python3 -c 'import json,sys;print(" ".join(json.load(open(sys.argv[1])).get("mcpServers",{})) or "(none)")' "$REPO/.mcp.json"
  else _st_line mcp; _st_none; fi
  if [ -d "$REPO/.claude/skills" ]; then _st_line skills; ( cd "$REPO/.claude/skills" && ls -d */ 2>/dev/null | tr -d '/' | tr '\n' ' '; echo )
  else _st_line skills; _st_none; fi

  printf '%sCodex%s\n' "$_bld" "$_rst"
  if [ -d "$REPO/.codex/hooks" ]; then _st_line hooks; ( cd "$REPO/.codex/hooks" && ls *.sh 2>/dev/null | grep -v '^_lib' | tr '\n' ' '; echo )
  else _st_line hooks; _st_none; fi
  if [ -f "$REPO/.codex/config.toml" ] && have python3; then _st_line mcp; python3 -c 'import tomllib,sys;d=tomllib.load(open(sys.argv[1],"rb"));print(" ".join(d.get("mcp_servers",{})) or "(none)")' "$REPO/.codex/config.toml"
  else _st_line mcp; _st_none; fi
  if [ -d "$REPO/.agents/skills" ]; then _st_line skills; ( cd "$REPO/.agents/skills" && ls -d */ 2>/dev/null | tr -d '/' | tr '\n' ' '; echo )
  else _st_line skills; _st_none; fi

  printf '%sPi%s\n' "$_bld" "$_rst"
  if [ -f "$REPO/.pi/mcp.json" ] && have python3; then _st_line mcp; python3 -c 'import json,sys;print(" ".join(json.load(open(sys.argv[1])).get("mcpServers",{})) or "(none)")' "$REPO/.pi/mcp.json"
  else _st_line mcp; _st_none; fi
  if [ -d "$REPO/.agents/skills" ]; then _st_line skills; ( cd "$REPO/.agents/skills" && ls -d */ 2>/dev/null | tr -d '/' | tr '\n' ' '; echo )
  else _st_line skills; _st_none; fi

  printf '%sKnowledge%s\n' "$_bld" "$_rst"
  _st_line files; { [ -f "$REPO/AGENTS.md" ] && printf 'AGENTS.md '; [ -f "$REPO/CLAUDE.md" ] && printf 'CLAUDE.md'; [ -f "$REPO/AGENTS.md" ] || [ -f "$REPO/CLAUDE.md" ] || printf '%s(none)%s' "$_dim" "$_rst"; echo; }
  info "'ai-toolbox recommend' suggests what to add for this stack; 'ai-toolbox list' shows everything."
}

# ----------------------------------------------------------------------------
cmd_help() {
  cat <<EOF
${_bld}ai-toolbox${_rst} — set up ai-toolbox pieces in a repo (ai-toolbox root: $TOOLBOX_ROOT)

  ${_bld}ai-toolbox init${_rst} [--yes|--dry-run]         scaffold AGENTS.md/CLAUDE.md + install the tailored set
  ${_bld}ai-toolbox bootstrap${_rst} [--yes|--dry-run]    just the functional layer (hooks/MCPs/skills), no knowledge files
  ${_bld}ai-toolbox recommend${_rst}                      show the recommended set for this repo (read-only)
  ${_bld}ai-toolbox status${_rst}                         what's installed in this repo
  ${_bld}ai-toolbox list${_rst}                           everything the ai-toolbox offers

  ${_bld}ai-toolbox hooks${_rst} [name...]                copy hooks + wire settings.json / .codex config.toml (default: all)
  ${_bld}ai-toolbox pi-init${_rst}                         install pi-mcp-extension globally (one-time Pi MCP setup)
  ${_bld}ai-toolbox mcp${_rst} <preset...>                merge MCP preset(s) into .mcp.json / .codex/config.toml / .pi/mcp.json
  ${_bld}ai-toolbox skill${_rst} <name...> [--user]       copy skill(s) into .claude/skills / .agents/skills
  ${_bld}ai-toolbox rules${_rst} <stack...>               print rule snippets to inline into AGENTS.md
  ${_bld}ai-toolbox with-dotenv${_rst}                    drop the .env loader for MCP secrets
  ${_bld}ai-toolbox base-charter${_rst}                   append the always-on charter to the harness global config (per machine)

Global: ${_bld}--repo <path>${_rst} targets another repo (default: current directory).
        ${_bld}--harness claude|codex|pi|both|all${_rst} picks the target harness(es); default auto-detects
        initialized homes (~/.claude, ~/.codex, ~/.pi) and writes for those. Claude Code reads .claude/ +
        .mcp.json; Codex reads .codex/config.toml + .agents/skills; pi reads .pi/mcp.json (via the
        pi-mcp-extension package) + .agents/skills. base-charter global: ~/.claude/CLAUDE.md,
        ~/.codex/AGENTS.md.
Set ${_bld}AI_TOOLBOX${_rst} to override the ai-toolbox location. Idempotent — safe to re-run.
EOF
}

# --- dispatch ---
cmd="${1:-help}"; shift || true
case "$cmd" in
  hooks)         cmd_hooks "$@" ;;
  mcp)           cmd_mcp "$@" ;;
  skill|skills)  cmd_skill "$@" ;;
  rules|rule)    cmd_rules "$@" ;;
  with-dotenv)   cmd_with_dotenv "$@" ;;
  pi-init)       cmd_pi_init "$@" ;;
  base-charter)  cmd_base_charter "$@" ;;
  recommend|reco) cmd_recommend "$@" ;;
  init)          cmd_init "$@" ;;
  bootstrap)     cmd_bootstrap "$@" ;;
  list|ls)       cmd_list "$@" ;;
  status|st)     cmd_status "$@" ;;
  help|-h|--help) cmd_help ;;
  *) die "unknown command: $cmd (run 'ai-toolbox help')" ;;
esac
