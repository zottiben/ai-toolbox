#!/usr/bin/env bash
# ai-toolbox — a shim over the binary.
#
# This used to be the tool: 885 lines of bash plus four python3 helpers doing the JSON
# merges and hand-writing Codex TOML. All of that is now one Rust engine that the CLI,
# the board and the desktop app share, so there is no second implementation of the merge
# rules to drift from the first.
#
# The file survives for one reason: `bin/ai-toolbox` is what a clone puts on PATH, and
# the skills in this repo shell out to it by that name. Every command, flag and exit code
# is the binary's, unchanged.
#
# Install properly with:
#   curl -fsSL https://zottiben.github.io/ai-toolbox/install.sh | sh
set -euo pipefail

# Resolve the clone this script lives in, following symlinks, so a PATH symlink works.
_self="${BASH_SOURCE[0]}"
while [ -h "$_self" ]; do
  _dir=$(cd -P "$(dirname "$_self")" && pwd)
  _self=$(readlink "$_self")
  case "$_self" in /*) ;; *) _self="$_dir/$_self" ;; esac
done
ROOT="${AI_TOOLBOX:-$(cd -P "$(dirname "$_self")/.." && pwd)}"

# An `ai-toolbox` already on PATH is the installed one and is preferred - but never this
# file, or the shim would call itself for ever.
_installed=$(command -v ai-toolbox 2>/dev/null || true)
if [ -n "$_installed" ] && [ "$(cd -P "$(dirname "$_installed")" && pwd)/$(basename "$_installed")" != "$_self" ]; then
  case "$(head -c 2 "$_installed" 2>/dev/null)" in
    '#!') ;;                       # another script: probably this shim by another name
    *) exec "$_installed" "$@" ;;  # a real binary
  esac
fi

# Otherwise a build in this clone, release first.
for candidate in "$ROOT/target/release/ai-toolbox" "$ROOT/target/debug/ai-toolbox"; do
  [ -x "$candidate" ] && exec "$candidate" "$@"
done

printf '\033[1;31mai-toolbox:\033[0m no binary found.\n' >&2
printf '  install:  curl -fsSL https://zottiben.github.io/ai-toolbox/install.sh | sh\n' >&2
printf '  or build: cargo build --release -p ai-toolbox\n' >&2
exit 1
